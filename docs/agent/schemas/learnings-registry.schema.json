{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dev-pipeline.local/schemas/learnings-registry.schema.json",
  "title": "Governed Learnings Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "entries"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "contract_version": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "claim", "scope_tags", "conflict_key", "source_story", "evidence_refs", "confidence", "owner", "created_at", "reviewed_by", "expires_at", "supersedes"],
        "properties": {
          "id": {"type": "string", "pattern": "^LRN-[0-9]{4}$"},
          "status": {"type": "string", "enum": ["candidate", "active", "conflicted", "deprecated", "revoked"]},
          "claim": {"type": "string", "minLength": 12},
          "scope_tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "conflict_key": {"type": "string", "minLength": 1},
          "source_story": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
          "owner": {"type": "string", "minLength": 1},
          "created_at": {"type": "string", "format": "date-time"},
          "reviewed_by": {"type": ["string", "null"], "minLength": 1},
          "expires_at": {"type": ["string", "null"], "format": "date-time"},
          "supersedes": {"type": ["string", "null"], "pattern": "^LRN-[0-9]{4}$"}
        }
      }
    }
  }
}
