{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dev-pipeline.local/schemas/capability-declaration.schema.json",
  "title": "Local RGR Capability Declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "pack_version", "capabilities", "local_tools", "optional_integrations", "unsupported_features"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "pack_id": {"type": "string", "minLength": 1},
    "pack_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required", "provider", "description", "constraints"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "required": {"type": "boolean"},
          "provider": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 8},
          "constraints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "local_tools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "optional_integrations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unsupported_features": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
