{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dev-pipeline.local/schemas/stage-result.schema.json",
  "title": "Execution Stage Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "story_id", "attempt", "stage", "actor_role", "outcome", "commands", "artifact_refs", "criterion_evidence", "self_check"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "story_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "stage": {"type": "string", "enum": ["red_test", "green_code", "refactor"]},
    "actor_role": {"type": "string", "enum": ["test_author", "implementer", "refactorer"]},
    "outcome": {"type": "string", "enum": ["completed", "failed"]},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "output_ref"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "exit_code": {"type": "integer"},
          "output_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifact_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "criterion_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sc_id", "status", "evidence_refs"],
        "properties": {
          "sc_id": {"type": "string", "pattern": "^SC-[0-9]+$"},
          "status": {"type": "string", "enum": ["red_confirmed", "pass", "fail", "not_applicable"]},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "self_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "items"],
      "properties": {
        "complete": {"type": "boolean"},
        "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
