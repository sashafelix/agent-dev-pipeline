{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dev-pipeline.local/schemas/evaluation-corpus.schema.json",
  "title": "Evaluation Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pipeline_contract_version", "purpose", "metrics", "fixtures"],
  "properties": {
    "schema_version": {"type": "string", "const": "2.0"},
    "pipeline_contract_version": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["outcome", "success_criterion_coverage", "evidence_completeness", "unnecessary_changed_files", "convergence_attempts", "reviewer_corrections", "elapsed_seconds", "estimated_tokens"]}},
    "fixtures": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "profile", "description", "expected_outcome", "required_behaviours", "forbidden_behaviours", "risk_tags"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "profile": {"type": "string", "enum": ["small", "standard", "high-risk"]},
          "description": {"type": "string", "minLength": 8},
          "expected_outcome": {"type": "string", "enum": ["PASS", "FAIL", "WARN", "HALT"]},
          "required_behaviours": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "forbidden_behaviours": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "risk_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
