{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rigorroute.com/schemas/agent-dev-pipeline/run-event.v1.json",
  "title": "RunEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sequence", "timestamp", "story_id", "attempt", "stage", "event_type", "actor_role", "artifact_refs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sequence": {"type": "integer", "minimum": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "story_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "stage": {"type": "string", "enum": ["setup", "prepare", "brainstorm", "plan", "analyze", "red_test", "green_code", "refactor", "quality_gate", "converge", "close"]},
    "event_type": {"type": "string", "enum": ["run.created", "stage.started", "stage.completed", "stage.failed", "artifact.created", "command.started", "command.completed", "decision.recorded", "attempt.started", "run.completed", "run.failed"]},
    "actor_role": {"type": "string", "enum": ["orchestrator", "preparer", "specifier", "planner", "analyzer", "test_author", "implementer", "refactorer", "independent_verifier", "convergence_reviewer", "operator"]},
    "outcome": {"type": ["string", "null"], "enum": ["PASS", "WARN", "FAIL", "CONVERGED", "REMEDIATE", null]},
    "causation_sequence": {"type": ["integer", "null"], "minimum": 1},
    "correlation_id": {"type": ["string", "null"]},
    "artifact_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "safe_summary": {"type": ["string", "null"]}
  }
}
