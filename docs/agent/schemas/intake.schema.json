{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dev-pipeline.local/schemas/intake.schema.json",
  "title": "Structured Pre-Run Intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intake_id",
    "rounds",
    "status",
    "raw_request",
    "resolved",
    "questions",
    "task_spec",
    "project_profile_ref"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "intake_id": {
      "type": "string",
      "minLength": 1
    },
    "rounds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "status": {
      "type": "string",
      "enum": [
        "collecting",
        "ready",
        "blocked"
      ]
    },
    "raw_request": {
      "type": "string",
      "minLength": 1
    },
    "project_profile_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "resolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "value",
          "source",
          "source_ref",
          "confidence",
          "authority"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "user",
              "trusted_project_profile",
              "repository_evidence",
              "retrieval",
              "operator_default"
            ]
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "authority": {
            "type": "string",
            "enum": [
              "authoritative",
              "evidence",
              "advisory"
            ]
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "field",
          "question",
          "impact",
          "blocking",
          "answered"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q-[0-9]+$"
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 5
          },
          "impact": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "answered": {
            "type": "boolean"
          }
        }
      }
    },
    "task_spec": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "requirements",
        "constraints",
        "acceptance_criteria",
        "user_decisions"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "description": {
          "type": "string",
          "minLength": 5
        },
        "requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "user_decisions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
