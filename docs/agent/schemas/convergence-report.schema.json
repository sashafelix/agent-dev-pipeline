{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dev-pipeline.local/schemas/convergence-report.schema.json",
  "title": "Convergence Report Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "story_id", "attempt", "outcome", "blocking_gaps", "artifact_refs", "earliest_invalid_stage"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "story_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
    "outcome": {"type": "string", "enum": ["CONVERGED", "REMEDIATE", "FAILED"]},
    "blocking_gaps": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "category", "message", "evidence_refs", "earliest_invalid_stage"], "properties": {"id": {"type": "string", "minLength": 1}, "category": {"type": "string", "enum": ["criterion", "test", "scope", "implementation", "documentation", "evidence", "refactor_drift"]}, "message": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "earliest_invalid_stage": {"type": "string", "enum": ["brainstorm", "plan", "analyze", "red_test", "green_code", "refactor", "quality_gate"]}}}},
    "artifact_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "earliest_invalid_stage": {"type": ["string", "null"], "enum": ["brainstorm", "plan", "analyze", "red_test", "green_code", "refactor", "quality_gate", null]}
  }
}
