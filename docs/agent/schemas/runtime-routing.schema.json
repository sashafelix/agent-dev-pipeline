{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://agent-dev-pipeline.local/schemas/runtime-routing.schema.json",
  "title":"Governed Runtime Routing",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","contract_version","pack_id","pack_version","policy","targets","routes"],
  "properties":{
    "schema_version":{"type":"string","const":"1.0"},
    "contract_version":{"type":"string","minLength":1},
    "pack_id":{"type":"string","minLength":1},
    "pack_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "policy":{"type":"object","additionalProperties":false,"required":["selection","overlay_sources","repository_overrides_forbidden","fallback_requires_reason","capability_mismatch_blocks","runtime_may_not_expand_authority","learned_context_is_advisory"],"properties":{
      "selection":{"type":"string","const":"first_available_compatible"},
      "overlay_sources":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["operator","trusted_platform"]}},
      "repository_overrides_forbidden":{"type":"boolean","const":true},
      "fallback_requires_reason":{"type":"boolean","const":true},
      "capability_mismatch_blocks":{"type":"boolean","const":true},
      "runtime_may_not_expand_authority":{"type":"boolean","const":true},
      "learned_context_is_advisory":{"type":"boolean","const":true}
    }},
    "targets":{"type":"array","minItems":2,"items":{"type":"object","additionalProperties":false,"required":["id","adapter","model_ref","endpoint_ref","locality","cost_class","capabilities"],"properties":{
      "id":{"type":"string","pattern":"^[a-z0-9-]+$"},
      "adapter":{"type":"string","enum":["claude-code","openai-compatible","ollama","lm-studio","custom"]},
      "model_ref":{"type":"string","minLength":1},
      "endpoint_ref":{"type":["string","null"],"minLength":1},
      "locality":{"type":"string","enum":["local","external"]},
      "cost_class":{"type":"string","enum":["local","metered","frontier"]},
      "capabilities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9_]+$"}}
    }}},
    "routes":{"type":"array","minItems":9,"items":{"type":"object","additionalProperties":false,"required":["id","stage","role","required_model_capabilities","targets"],"properties":{
      "id":{"type":"string","pattern":"^[a-z0-9-]+$"},
      "stage":{"type":"string","enum":["*","prepare","brainstorm","plan","analyze","red_test","green_code","refactor","quality_gate","converge"]},
      "role":{"type":"string","minLength":1},
      "required_model_capabilities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9_]+$"}},
      "targets":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9-]+$"}}
    }}}
  }
}
