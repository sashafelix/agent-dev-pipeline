{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dev-pipeline.local/schemas/brainstorm.schema.json",
  "title": "Brainstorm Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "story_id", "success_criteria", "input_trace", "uncertainties"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "story_id": {"type": "string", "minLength": 1},
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "verified_by", "source"],
        "properties": {
          "id": {"type": "string", "pattern": "^SC-[0-9]+$"},
          "statement": {"type": "string", "minLength": 12},
          "verified_by": {"type": "string", "enum": ["unit", "integration", "contract", "e2e", "security", "static", "manual"]},
          "source": {"type": "string", "minLength": 1}
        }
      }
    },
    "input_trace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input_item", "covered_by"],
        "properties": {
          "input_item": {"type": "string", "minLength": 1},
          "covered_by": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SC-[0-9]+$"}}
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "status", "resolution_plan"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["resolved", "accepted_warning", "blocking"]},
          "resolution_plan": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
