{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dev-pipeline.local/schemas/export-manifest.schema.json",
  "title": "Local RGR Export Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_format_version", "pack_id", "pack_version", "protocol_version", "story_id", "created_at", "source_revision", "profile", "files", "validators", "root_hash", "contains_source_code", "contains_secrets"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "bundle_format_version": {"type": "string", "const": "1.0"},
    "pack_id": {"type": "string", "minLength": 1},
    "pack_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "protocol_version": {"type": "string", "minLength": 1},
    "story_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source_revision": {"type": "string", "minLength": 7},
    "profile": {"type": "string", "enum": ["small", "standard", "high-risk"]},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "media_type", "required"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "media_type": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"}
        }
      }
    },
    "validators": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["name", "version", "outcome"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "outcome": {"type": "string", "const": "PASS"}}}},
    "root_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "contains_source_code": {"type": "boolean", "const": false},
    "contains_secrets": {"type": "boolean", "const": false}
  }
}
