{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dev-pipeline.local/schemas/evaluation-result.schema.json",
  "title": "Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pipeline_version", "fixture_id", "outcome", "behaviour_checks", "metrics", "findings"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "pipeline_version": {"type": "string", "minLength": 1},
    "fixture_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "outcome": {"type": "string", "enum": ["PASS", "FAIL", "WARN", "HALT"]},
    "behaviour_checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success_criterion_coverage", "evidence_completeness", "unnecessary_changed_files", "convergence_attempts", "reviewer_corrections", "elapsed_seconds", "estimated_tokens"],
      "properties": {
        "success_criterion_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_completeness": {"type": "number", "minimum": 0, "maximum": 1},
        "unnecessary_changed_files": {"type": "integer", "minimum": 0},
        "convergence_attempts": {"type": "integer", "minimum": 0, "maximum": 2},
        "reviewer_corrections": {"type": "integer", "minimum": 0},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "estimated_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "findings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
