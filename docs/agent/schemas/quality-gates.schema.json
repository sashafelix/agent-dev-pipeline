{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dev-pipeline.local/schemas/quality-gates.schema.json",
  "title": "Quality Gate Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "story_id", "verdict", "reviewer_role", "reviewer_identity", "criterion_evidence", "hard_failures", "changed_files", "artifact_refs"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "story_id": {"type": "string", "minLength": 1},
    "verdict": {"type": "string", "enum": ["PASS", "FAIL", "WARN"]},
    "reviewer_role": {"type": "string", "const": "independent_verifier"},
    "reviewer_identity": {"type": "string", "minLength": 1},
    "criterion_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sc_id", "status", "tests", "evidence_refs"],
        "properties": {
          "sc_id": {"type": "string", "pattern": "^SC-[0-9]+$"},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "WARN"]},
          "tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "hard_failures": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "message", "evidence_refs"], "properties": {"id": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}},
    "changed_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "artifact_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
